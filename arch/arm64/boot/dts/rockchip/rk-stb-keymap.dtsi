	ir_key12{
		rockchip,usercode = <0x7f80>;
		rockchip,key_table =
			<0xec	KEY_REPLY>,
			<0xd8	KEY_BACK>,
			<0xc7	KEY_UP>,
			<0xbf	KEY_DOWN>,
			<0xc8	KEY_LEFT>,
			<0xc6	KEY_RIGHT>,
			<0x8c	KEY_HOME>,
			<0x78	KEY_VOLUMEUP>,
			<0x76	KEY_VOLUMEDOWN>,
			<0x7e	KEY_POWER>,
			<0xed	KEY_POWER>,  //20171123 
			<0x7c	KEY_MENU>,
			<0xb7	388>;
	};

	ir_key13{
		rockchip,usercode = <0x4040>;
		rockchip,key_table =
			    <0xe5 KEY_HOME>,
			    <0xbd KEY_BACK>, 		// back
