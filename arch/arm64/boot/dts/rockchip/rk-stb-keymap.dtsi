			    <0xf2 KEY_REPLY>,		// ok
			    <0xf4 KEY_UP>,	
			    <0xf1 KEY_DOWN>,
			    <0xef KEY_LEFT>,
			    <0xee KEY_RIGHT>,
			    <0xe3 KEY_VOLUMEDOWN>,
