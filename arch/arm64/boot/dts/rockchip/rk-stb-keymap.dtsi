			<0xf5 KEY_POWER>,
			<0xdd 248>, //186>, voice
			<0xff KEY_UP>,
			<0xfe KEY_DOWN>, 
			<0xfd KEY_RIGHT>,
			<0xfc KEY_LEFT>,
			<0xe0 KEY_REPLY>,
